classDiagram
    class Task {
        +str description
        +date due_date
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
        +update_details(description, due_date, time, duration_minutes, priority, frequency)
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
    }

    class Owner {
        +str name
        +int available_minutes
        +list pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks(pet_name, completed, due_date)
        +generate_daily_plan(due_date)
        +mark_task_complete(pet, task)
        +detect_conflicts()
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : retrieves tasks